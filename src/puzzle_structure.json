{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "difficulty": { "type": "string", "enum": ["easy", "medium", "hard", "expert"] },
    "context": {
      "type": "object",
      "properties": {
        "languageCode": { "type": "string" },
        "themeId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["languageCode", "themeId", "title"]
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "displayValue": { "type": "string" },
                "iconName": { "type": "string" }
              },
              "required": ["id", "displayValue"]
            }
          }
        },
        "required": ["id", "name", "items"]
      }
    },
    "clues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" }
        },
        "required": ["id", "text"]
      }
    },
    "solution": {
      "type": "object",
      "description": "Key is category ID, value is ordered array of item IDs corresponding to houses/slots 1-N"
    }
  },
  "required": ["id", "difficulty", "context", "categories", "clues", "solution"]
}
